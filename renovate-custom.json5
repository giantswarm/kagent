// Repo-specific Renovate rules. Added as the last `extends` entry of the
// generated renovate.json5 and never touched by devctl align-files.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // The bundled upstream subcharts under helm/kagent/charts/** are vendored by
  // sync/sync.sh from the published kagent chart. Their versions are upstream's
  // choice; bumping them here would be reverted by the next sync.
  ignorePaths: ['helm/*/charts/**'],
  packageRules: [
    {
      // The controller chart and the CRD chart are one upstream release and
      // must move together: bumping only one ships CRDs from a different
      // release than the controller. `make sync` then rewrites the tag pin,
      // values.yaml and the chart metadata from the vendored tree, and
      // `make verify-sync` (CI) fails if anything is left inconsistent. The
      // image tag in values.yaml has no Renovate marker: it is written from
      // the vendir.yml pin.
      matchPackageNames: [
        'ghcr.io/kagent-dev/kagent/helm/kagent',
        'ghcr.io/kagent-dev/kagent/helm/kagent-crds',
      ],
      groupName: 'kagent',
    },
    {
      // Never propose a kagent prerelease. Upstream tags 0.10.0-rc* and
      // 0.10.0-beta* and marks the newest rc as the GitHub "Latest" release.
      matchPackageNames: [
        'ghcr.io/kagent-dev/kagent/helm/kagent',
        'ghcr.io/kagent-dev/kagent/helm/kagent-crds',
      ],
      allowedVersions: '!/-(alpha|beta|rc)/',
    },
  ],
}
